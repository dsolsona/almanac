# Start from an empty context and allow only build inputs.
**
!Dockerfile
!go.mod
!go.sum
!cmd/
!cmd/**
!internal/
!internal/**
!web/
!web/assets.go
!web/index.html
!web/package.json
!web/package-lock.json
!web/tsconfig.json
!web/vite.config.ts
!web/src/
!web/src/**
!web/public/
!web/public/**
!deploy/
!deploy/local/
!deploy/local/init.sh
!deploy/local/init-test.sh

# Secret exclusions come last so no allowlist rule can re-include them.
.env
.env.*
**/.env
**/.env.*
*.pem
*.key
**/*.pem
**/*.key
*.secret
*.secrets
**/*.secret
**/*.secrets
