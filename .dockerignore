# Start from an empty context and allow only build inputs.
**
!Dockerfile
!go.mod
!go.sum
!cmd/
!cmd/**
!internal/
!internal/**

!web/
web/*
!web/assets.go
!web/index.html
!web/package.json
!web/package-lock.json
!web/tsconfig.json
!web/vite.config.ts
!web/src/
web/src/*
!web/src/**
!web/public/
web/public/*
!web/public/**

!deploy/
deploy/*
!deploy/local/
deploy/local/*
!deploy/local/init.sh
!deploy/local/init-test.sh

# Secret exclusions come after all allowlist rules.
.env
.env.*
**/.env
**/.env.*
*.pem
*.key
**/*.pem
**/*.key
*.secret
*.secrets
**/*.secret
**/*.secrets

# Exclude common generated or vendored artifacts even if a parent is re-included.
**/node_modules
**/.local
**/.git
**/.worktrees
web/dist
web/test-results
web/playwright-report
